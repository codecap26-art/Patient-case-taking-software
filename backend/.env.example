# Database Configuration
# PostgreSQL connection string: postgresql+psycopg2://user:password@localhost:5432/patient_case_taking_db
# For SQLite (local testing fallback): sqlite:///./app.db
DATABASE_URL=sqlite:///./app.db

# Security & JWT Secrets
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# QR Token Signing Secret
QR_SIGNING_SECRET=your_qr_identity_signing_key_here

# Application
APP_NAME=Patient Case Taking API
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080,http://127.0.0.1:8000,http://localhost:5000,http://localhost:5173

# File Storage
STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# Mock / Simulation Mode for External Services
MOCK_EXTERNAL_SERVICES=False

# OCR Configuration (Imported from SIH_OCR PaddleOCR Engine)
OCR_ENABLED=true
DEFAULT_LANGUAGE=bilingual
MAX_FILE_SIZE_BYTES=20971520
MAX_IMAGE_DIMENSION=1400
CONTRAST_ENHANCE_FACTOR=1.15

# LLM Clinical Extraction API (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.8-27b
